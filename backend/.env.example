# Copy this file to backend/.env for local development. Never commit the real one.
# Every variable the backend reads is declared in app/core/config.py.

ENVIRONMENT=local

# --- Database: MongoDB ------------------------------------------------------
# Atlas connection string (mongodb+srv://...). Required: the API will not start without it.
# URL-encode special characters in the password (@ becomes %40).
MONGODB_URL=
MONGODB_DB_NAME=dhruv
# Integration tests create a throwaway test_dhruv_<random> database here and drop it.
# Use a local MongoDB, not Atlas — the suite makes thousands of round trips:
#   docker run -d -p 27018:27017 mongo:8.0
TEST_MONGODB_URL=mongodb://localhost:27018

# --- Tokens (PRD 7.2) -------------------------------------------------------
# ES256 key pair. Generate locally, paste here, then delete the files:
#   openssl ecparam -genkey -name prime256v1 -noout -out jwt.pem
#   openssl ec -in jwt.pem -pubout
# Paste the PEM with literal \n between lines, wrapped in double quotes.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=k1

# --- OTP (PRD 7.3) ----------------------------------------------------------
# 32+ random characters:  python -c "import secrets; print(secrets.token_urlsafe(32))"
OTP_PEPPER=

# --- Email (PRD 9) ----------------------------------------------------------
# Leave RESEND_API_KEY blank locally: emails are then logged, never sent.
RESEND_API_KEY=
EMAIL_FROM=Dhruv Online Academy <noreply@dhruvonlineacademy.com>

# --- Web security (PRD 7.5) -------------------------------------------------
# Blank locally. In production: .dhruvonlineacademy.com
# Where the web app is served. Used to build the links in invitation and reset emails,
# so a recipient has somewhere to take their code.
FRONTEND_URL=https://dhruvonlineacademy.com

COOKIE_DOMAIN=
CORS_ORIGINS=["http://localhost:5173"]
# Path to the built frontend (frontend/dist). Blank locally; the Docker image sets it so
# the API serves the web app on the same URL.
FRONTEND_DIST_DIR=

# --- Seed and monitoring ----------------------------------------------------
# The first Super Admin. Created as `invited` with no password; they set one
# through the forgot-password flow.
SEED_SUPERADMIN_EMAIL=
SENTRY_DSN=

# --- Optional tuning (sensible defaults live in config.py) ------------------
# RATE_LIMITS_ENABLED=true
# DIRECT_SIGNUP_ENABLED=true     # PRD 14 Q2 is still open with the client
# MAX_FAILED_LOGINS=5
# ACCOUNT_LOCK_MINUTES=15
# PERMISSION_CACHE_TTL_SECONDS=60
# ACCESS_TOKEN_TTL_MINUTES=15
# REFRESH_TOKEN_TTL_DAYS=7
# REFRESH_TOKEN_TTL_DAYS_REMEMBERED=30
